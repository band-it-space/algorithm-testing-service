# Algorithm Testing Service - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# External API Configuration
# =============================================================================

# StockFisher API (for HK market data)
API_KEY=your-stockfisher-api-key-here
STOCKFISHER_URL=http://ete.stockfisher.com.hk/

# US King API (for US market data)
US_KING_API_KEY=your-us-king-api-key-here

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis host (use 'localhost' for local development, 'redis' in Docker)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# =============================================================================
# Application Configuration
# =============================================================================

# API server port
API_PORT=8000

# RQ Dashboard port
DASHBOARD_PORT=9181

# Environment: development, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Auto-reload on code changes (true/false)
AUTO_RELOAD=true

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

