# =================================
# Redis Configuration
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =================================
# API Service Configuration
# =================================
API_PORT=8000
DASHBOARD_PORT=9181
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
AUTO_RELOAD=true

API_KEY=your_api_key_here

# =================================
# Google Sheets Configuration
# =================================
GOOGLE_SHEETS_CREDENTIALS_PATH=/app/credentials/google_sheets.json
INPUT_SHEET_ID=your_input_sheet_id
OUTPUT_SHEET_ID=your_output_sheet_id

# =================================
# Worker Configuration
# =================================
ALGORITHM_WORKER_TIMEOUT=1000
ALGORITHM_WORKER_MAX_RETRIES=3
RESULT_WORKER_TIMEOUT=300
RESULT_WORKER_MAX_RETRIES=3
FILE_WRITE_WORKER_TIMEOUT=60
FILE_WRITE_WORKER_MAX_RETRIES=3

# =================================
# Worker Parallelization
# =================================
# Number of worker processes per container
ALGORITHM_WORKER_COUNT=1
RESULT_WORKER_COUNT=1
FILE_WORKER_COUNT=1

# Number of concurrent tasks per worker process (in-worker parallelization)
WORKER_CONCURRENT_TASKS=1

# =================================
# Optimization Date Range
# =================================
# Date range for algorithm optimization processing (YYYY-MM-DD)
OPTIMIZATION_START_DATE=2025-01-01
OPTIMIZATION_END_DATE=2026-02-02

# =================================
# Algorithm Worker Debug Mode
# =================================
# Enable verbose debug logging for algorithm processing
ALGORITHM_DEBUG=false
# Log progress every N trade days
LOG_PROGRESS_INTERVAL=100

# =================================
# Health Check Configuration
# =================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
