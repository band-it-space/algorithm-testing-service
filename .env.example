# =================================
# Redis Configuration
# =================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =================================
# API Service Configuration
# =================================
API_PORT=8000
DASHBOARD_PORT=9181
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
AUTO_RELOAD=true

API_KEY=your-api-key

# =================================
# Google Sheets Configuration (for Dynamic Parameters Integration)
# =================================
# Path to service account JSON file (inside container)
GOOGLE_SHEETS_CREDENTIALS_PATH=/app/credentials/google_sheets.json

# Google Sheet ID for reading parameter ranges and writing results
# (Extract from sheet URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
# Note: Input tab = "Parameter Tuning", Output tab = "Automated Results"
INPUT_SHEET_ID=
OUTPUT_SHEET_ID=

# =================================
# Worker Configuration
# =================================
ALGORITHM_WORKER_TIMEOUT=1000
ALGORITHM_WORKER_MAX_RETRIES=3
RESULT_WORKER_TIMEOUT=300
RESULT_WORKER_MAX_RETRIES=3
FILE_WRITE_WORKER_TIMEOUT=60
FILE_WRITE_WORKER_MAX_RETRIES=3

# =================================
# Health Check Configuration
# =================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
