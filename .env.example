# Algorithm Testing Service - Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# External API Configuration
# =============================================================================

# StockFisher API (for HK market data)
API_KEY=your-stockfisher-api-key-here
STOCKFISHER_URL=https://api.stockfisher.example.com

# US King API (for US market data)
US_KING_API_KEY=your-us-king-api-key-here

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis host (use 'localhost' for local development, 'redis' in Docker)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# Redis password (leave empty if no authentication)
REDIS_PASSWORD=

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for log files
LOG_DIR=logs

# =============================================================================
# Application Configuration
# =============================================================================

# Python path (set automatically in Docker, can be omitted locally)
PYTHONPATH=/app

# Directory for CSV data files
DATA_DIR=data

# =============================================================================
# Development Settings (Optional)
# =============================================================================

# API server host (default: 0.0.0.0)
# API_HOST=0.0.0.0

# API server port (default: 8000)
# API_PORT=8000

# Enable debug mode (default: false)
# DEBUG=false
